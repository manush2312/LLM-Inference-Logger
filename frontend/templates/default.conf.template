# Resolve the backend at request time, not once at startup.
#
# nginx caches a static `proxy_pass hostname` for the process lifetime, so the
# moment the backend container or pod gets a new IP -- any restart, any rolling
# deploy -- every request 502s against the dead address until nginx itself is
# restarted. Observed exactly that after recreating the backend container.
#
# Two halves are required: a `resolver`, and a *variable* in `proxy_pass`, which
# is what makes nginx defer the lookup. `NGINX_LOCAL_RESOLVERS` is populated by
# the image's own entrypoint from /etc/resolv.conf.
#
# The catch, and it cost a 502 in Kubernetes: nginx's `resolver` does NOT apply
# the `search` domains from /etc/resolv.conf. It only ever issues absolute
# lookups. Under Docker's flat embedded DNS `backend` resolves either way, so
# switching to runtime resolution looked free -- but in Kubernetes short names
# depend entirely on `search llm-logger.svc.cluster.local ...`, and the bare
# name became `Host not found` on every request while the backend pods sat
# there perfectly ready.
#
# So the upstream authority is injected instead of assumed: compose keeps the
# short `backend:8000`, Kubernetes supplies the FQDN. Anything that gives nginx
# a name its own resolver can answer works here.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    # 8080, not 80: this runs as a non-root user with no
    # CAP_NET_BIND_SERVICE, so a privileged port is not bindable.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Client-side routing: /c/<id> and /dashboard are React routes with no file
    # behind them, so unmatched paths fall through to the app shell instead of
    # 404ing. A hard refresh on a conversation URL has to work -- that is the
    # whole resume-after-refresh behaviour.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Content-hashed asset filenames make these immutable.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # --- API proxy ----------------------------------------------------------
    # Same-origin, so the browser never issues a cross-origin request in
    # production.
    location ~ ^/(chat|conversations|providers|metrics|healthz|readyz|docs|openapi\.json) {
        # Via a variable, so the resolver above is actually consulted. Note the
        # explicit $request_uri: with a variable in proxy_pass nginx does *not*
        # append the original URI for you, so omitting it silently sends every
        # request to `/`.
        set $upstream http://${BACKEND_UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for SSE. Without buffering off, nginx holds the whole
        # response and delivers it in one lump at the end -- the stream still
        # "works" but arrives all at once, which defeats streaming entirely and
        # is a genuinely confusing thing to debug from the browser side.
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";

        # A generation can legitimately run for minutes; the default 60s would
        # cut long streams off mid-reply.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
