# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value here has a working default for local
# development EXCEPT the provider API keys -- and even those are optional,
# because the built-in `mock` provider runs the full stack without any keys.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=local                 # local | docker | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console (human, dev) | json (machine, prod)

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=llm
POSTGRES_PASSWORD=llm
POSTGRES_DB=llm_logger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# Event bus backend: redis | memory
# `memory` runs the ingestion consumer in-process -- useful for tests and for
# running the API standalone without Redis. `redis` is the real architecture.
EVENT_BUS_BACKEND=redis

# Max time the request path will wait on the event bus before giving up on the
# log and returning the user's response anyway. Logging must never break chat.
EVENT_PUBLISH_TIMEOUT_MS=200

# Cap the stream so a stalled worker cannot exhaust Redis memory.
EVENT_STREAM_MAXLEN=100000

# --- Providers -------------------------------------------------------------
# Leave blank to disable a provider. The `mock` provider is always available.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DEFAULT_PROVIDER=mock
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-5
DEFAULT_OPENAI_MODEL=gpt-4o

# --- Instrumentation -------------------------------------------------------
# How much of the prompt/completion to persist alongside each inference log.
PREVIEW_MAX_CHARS=500
REDACTION_ENABLED=true

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
