# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value here has a working default for local
# development EXCEPT the provider API keys -- and even those are optional,
# because the built-in `mock` provider runs the full stack without any keys.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=local                 # local | docker | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console (human, dev) | json (machine, prod)

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=llm
POSTGRES_PASSWORD=llm
POSTGRES_DB=llm_logger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# Event bus backend: redis | memory
# `memory` runs the ingestion consumer in-process -- useful for tests and for
# running the API standalone without Redis. `redis` is the real architecture.
EVENT_BUS_BACKEND=redis

# Max time the request path will wait on the event bus before giving up on the
# log and returning the user's response anyway. Logging must never break chat.
EVENT_PUBLISH_TIMEOUT_MS=200

# Cap the stream so a stalled worker cannot exhaust Redis memory.
EVENT_STREAM_MAXLEN=100000

# --- Providers -------------------------------------------------------------
# Leave blank to disable a provider. The `mock` provider is always available.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DEFAULT_PROVIDER=mock
DEFAULT_ANTHROPIC_MODEL=claude-opus-5
DEFAULT_OPENAI_MODEL=gpt-4o

# --- Free / local providers ------------------------------------------------
# Groq, Gemini and Ollama all speak the OpenAI wire format, so they reuse the
# OpenAI adapter pointed at a different address. Each keeps its own provider
# name, so the dashboard can tell their traffic apart.

# Groq: free tier, no card required. https://console.groq.com
GROQ_API_KEY=
# Model names go stale. List what your key can actually reach with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
DEFAULT_GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini via its OpenAI-compatibility endpoint. Free tier, no card.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-flash-latest

# Ollama: a model on this machine. No key, no network, no cost.
#   brew install ollama && ollama serve && ollama pull llama3.2
# Opt-in explicitly rather than probed: registering a server we cannot reach
# would turn a clear "not configured" error into a mid-stream connection failure.
OLLAMA_ENABLED=false
DEFAULT_OLLAMA_MODEL=llama3.2
# Inside a container `localhost` is the container. Compose overrides this to
# host.docker.internal; leave it as-is when running the API on the host.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Caps provider output. On models with reasoning enabled this covers reasoning
# AND the visible answer, so a value tuned for answer length alone truncates.
MAX_OUTPUT_TOKENS=16000

# --- Instrumentation -------------------------------------------------------
# How much of the prompt/completion to persist alongside each inference log.
PREVIEW_MAX_CHARS=500
REDACTION_ENABLED=true

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
